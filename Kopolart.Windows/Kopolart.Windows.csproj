<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>false</UseWPF>

		<RootNamespace>Kopolart.Windows</RootNamespace>
		<AssemblyName>kopolart-win-x64</AssemblyName>

		<Nullable>enable</Nullable>

		<ApplicationIcon>assets\images\kopolart_icon.ico</ApplicationIcon>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>

		<Version>1.6.2</Version>
		<FileVersion>1.6.2.0</FileVersion>
		<AssemblyVersion>1.6.2.0</AssemblyVersion>
		<InformationalVersion>1.6.2</InformationalVersion>
		<Company>Kopolart</Company>
		<Product>Kopolart</Product>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Embedded PDBs keep file/line info in crash logs without extra files. -->
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(BundleWebView2Runtime)' == 'true'">
		<!--<PackageReference Include="WebView2.Runtime.X64" Version="144.0.3719.104" />-->
		<PackageReference Include="WebView2.Runtime.X64" Version="*" />
	</ItemGroup>

	<ItemGroup>
		<None Update="assets\images\kopolart_logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="assets\images\kopolart_logo_dark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="assets\images\kopolart_icon.ico" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
	</ItemGroup>
	<!-- Font family: the licensed Abar family is embedded only when it is present locally.
	     The public repository ships the OFL Estedad family instead, because Abar may not
	     be redistributed. FontManager resolves either set by family name. -->
	<ItemGroup Condition="Exists('assets\font\AbarLow-Regular.ttf')">
		<EmbeddedResource Include="assets\font\AbarLow-Regular.ttf" />
		<EmbeddedResource Include="assets\font\AbarMid-Bold.ttf" />
		<EmbeddedResource Include="assets\font\AbarHigh-Black.ttf" />
	</ItemGroup>
	<ItemGroup Condition="!Exists('assets\font\AbarLow-Regular.ttf')">
		<EmbeddedResource Include="assets\font\Estedad-Regular.ttf" />
		<EmbeddedResource Include="assets\font\Estedad-ExtraBold.ttf" />
		<EmbeddedResource Include="assets\font\Estedad-Black.ttf" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="assets\font\kopolart-fa.ttf" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="assets\web\offline.html" />
		<EmbeddedResource Include="assets\web\offline.css" />
		<EmbeddedResource Include="assets\web\offline.js" />
		<EmbeddedResource Include="assets\js\findbar.js" />
		<EmbeddedResource Include="assets\js\shortcuts.js" />
		<EmbeddedResource Include="assets\css\findbar.css" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Kopolart.Windows.Domain\Kopolart.Windows.Domain.csproj" />
	  <ProjectReference Include="..\Kopolart.Windows.Application\Kopolart.Windows.Application.csproj" />
	  <ProjectReference Include="..\Kopolart.Windows.Infrastructure\Kopolart.Windows.Infrastructure.csproj" />
	</ItemGroup>
</Project>